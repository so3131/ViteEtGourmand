# .env.example pour XAMPP/local utilisées par env.php, en local uniquement

APP_ENV=local
# Configuration MongoDB
MONGODB_URI=mongodb+srv://xxx:xxx@cluster.exemple.mongodb.net/?appName=xxx


# Configuration MariaDB / MySQL
DB_HOST=localhost
DB_NAME=xxx
DB_USER=xxx
DB_PASS=xxx

# Configuration Brevo 
BREVO_API_KEY=xxx
MAIL_FROM_EMAIL=xxx



# Configuration OpenRouteService
OPENROUTESERVICE_API_KEY=xxx

APP_URL=http://localhost/Projet_Vite_Gourmand_Finale/public
