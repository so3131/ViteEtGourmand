<IfModule mod_expires.c>
    ExpiresActive On
    # Images : 1 an (peu risqué, cette partie une fois déployée change rarement)
    ExpiresByType image/webp  "access plus 1 year"
    ExpiresByType image/png  "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    # CSS / JS : 1 mois (prudent, en cas de modification du code)
    ExpiresByType text/css               "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
    # CSS / JS : cache public avec expiration, pas d'immutable (pour pouvoir mettre à jour)
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    # Images : cache long + immutable (sûr car on ne modifie pas une image déployée)
    <FilesMatch "\.(webp|png|jpg|jpeg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
