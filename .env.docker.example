# .env.docker.example pour Docker (DB_HOST n'y est pas. C'est docker-compose.yml qui le fixe à db en dur)
# Utilisé par le lancement avec la commande "docker compose --env-file .env.docker" .
#  modifier mes clés pour utiliser un compte Brevo de test supplementaire, et un compte OpenRouteService de test supplementaire, pour ne pas dépasser les quotas gratuits.

# variable d'environnement pour la base de données via Docker
DB_ROOT_PASS=xxx
DB_NAME=xxx
DB_USER=xxx
DB_PASS=xxx

# Configuration MongoDB
MONGODB_URI=mongodb+srv://xxx:xxx@cluster.exemple.mongodb.net/?appName=xxx
# Configuration Brevo
BREVO_API_KEY=xxx
# Configuration Mail
MAIL_FROM_EMAIL=xxx
# Configuration OpenRouteService
OPENROUTESERVICE_API_KEY=xxx